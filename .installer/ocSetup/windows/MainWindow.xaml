<Window x:Class="OcSetup.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:OcSetup.ViewModels"
        Title="oc dependencies"
        Width="720"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontSize="14"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="3" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Background" Value="{StaticResource ControlAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- The default CheckBox template draws system-colored (black) text on the dark background. -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ControlAltBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource SmallCornerRadius}">
                                <Path x:Name="Mark"
                                      Data="M 3,8 L 6.5,11.5 L 13,4.5"
                                      Stroke="{StaticResource PrimaryTextBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter x:Name="Content" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Three pulsing dots after "Checking". Runs only while visible (20 fps: App's static ctor). -->
        <Style x:Key="LoadingDotsStyle" TargetType="{x:Type ContentControl}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContentControl}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Dot1" Text="." Opacity="0.25" />
                            <TextBlock x:Name="Dot2" Text="." Opacity="0.25" />
                            <TextBlock x:Name="Dot3" Text="." Opacity="0.25" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Pulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever" />
                                            <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"
                                                             BeginTime="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"
                                                             BeginTime="0:0:0.4" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ListPanel" Margin="{StaticResource PageMargin}" Style="{StaticResource ContentPanelStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- Header icons and row cells are all 16 wide with the same margins, so each icon
                     sits over its column without shared sizing. -->
                <StackPanel>
                <!-- Shown with the rows once the list loads (ReadRowsAsync). -->
                <StackPanel x:Name="HeaderIcons" Margin="0,0,0,6" Orientation="Horizontal" Visibility="Collapsed">
                    <!-- Transparent borders make the whole 16x16 cell hoverable, not just the glyph. -->
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Width" Value="16" />
                            <Setter Property="Height" Value="16" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <!-- Lucide stroke icons: a fixed 24x24 Path keeps the SVG viewBox (Stretch
                             would fit each icon to its own bounds); the Viewbox scales it to 16. -->
                        <Style TargetType="{x:Type Path}">
                            <Setter Property="Width" Value="24" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Stroke" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="StrokeStartLineCap" Value="Round" />
                            <Setter Property="StrokeEndLineCap" Value="Round" />
                            <Setter Property="StrokeLineJoin" Value="Round" />
                        </Style>
                    </StackPanel.Resources>
                    <Border AutomationProperties.Name="Install or update" ToolTip="Install or update">
                        <Viewbox>
                            <Path Data="{StaticResource InstallIconGeometry}" />
                        </Viewbox>
                    </Border>
                    <Border Margin="8,0,0,0"
                            AutomationProperties.Name="Create desktop shortcut"
                            ToolTip="Create desktop shortcut">
                        <Viewbox>
                            <Path Data="{StaticResource ShortcutIconGeometry}" />
                        </Viewbox>
                    </Border>
                    <Border Margin="12,0,0,0"
                            AutomationProperties.Name="Filled dot: Required. Ring: Default."
                            ToolTip="● Required: oc needs this&#10;○ Default: checked by default when missing">
                        <Viewbox>
                            <Path Data="{StaticResource TagIconGeometry}" />
                        </Viewbox>
                    </Border>
                </StackPanel>
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:DependencyRow}">
                            <StackPanel Margin="0,0,0,10" ToolTip="{Binding ToolTip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox HorizontalAlignment="Left"
                                              AutomationProperties.Name="{Binding Label}"
                                              IsChecked="{Binding IsChecked}"
                                              IsEnabled="{Binding CanCheck}" />
                                    <!-- Hidden (not collapsed) on rows without a shortcut keeps the labels aligned. -->
                                    <CheckBox Grid.Column="1"
                                              Margin="8,0,0,0"
                                              AutomationProperties.Name="{Binding Label, StringFormat={}{0} desktop shortcut}"
                                              IsChecked="{Binding WantsShortcut}"
                                              IsEnabled="{Binding CanShortcut}"
                                              ToolTip="Create a desktop shortcut">
                                        <CheckBox.Style>
                                            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasShortcut}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <!-- Tag dot: filled = Required, ring = Default (shape, not just color).
                                         16x16 transparent cell is the hover target; hidden (not
                                         collapsed) on untagged rows keeps the labels aligned. -->
                                    <Border Grid.Column="2"
                                            Width="16"
                                            Height="16"
                                            Margin="12,0,0,0"
                                            Background="Transparent"
                                            AutomationProperties.Name="{Binding TagText}"
                                            ToolTip="{Binding TagToolTip}">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTag}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="{x:Type Ellipse}">
                                                    <Setter Property="Stroke" Value="{StaticResource AccentBorderBrush}" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Item.Required}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Border>
                                    <!-- Dims like the old checkbox content did when install is locked. -->
                                    <TextBlock Grid.Column="3"
                                               Margin="12,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanCheck}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="4" Margin="16,0,0,0" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding StatusText}" />
                                        <ContentControl Style="{StaticResource LoadingDotsStyle}"
                                                        Visibility="{Binding IsChecking, Converter={StaticResource BooleanToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibility}}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                                             Maximum="100"
                                             Value="{Binding ProgressValue, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Shown after an install run; replaces the list and the bottom bar. -->
        <Border x:Name="DonePanel"
                Grid.RowSpan="2"
                Margin="{StaticResource PageMargin}"
                Style="{StaticResource ContentPanelStyle}"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="DoneHeading"
                           DockPanel.Dock="Top"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource NeutralButtonStyle}"
                            Content="Back to list"
                            Click="BackButton_Click" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource NeutralButtonStyle}"
                            Content="Close"
                            Click="CloseButton_Click" />
                    <Button x:Name="OpenOcButton"
                            DockPanel.Dock="Right"
                            Content="Open oc and close"
                            Click="OpenOcButton_Click" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,0,0,12"
                           FontSize="14"
                           Text="Open oc now?" />
                <TextBlock x:Name="DoneDetails"
                           Margin="0,16,0,16"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>

        <DockPanel x:Name="BottomBar" Grid.Row="1" Margin="{StaticResource PageMargin}" LastChildFill="True">
            <Button x:Name="InstallButton"
                    DockPanel.Dock="Right"
                    Content="Install selected"
                    IsEnabled="False"
                    Click="InstallButton_Click" />
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <!-- Shown while the list loads (LoadRowsAsync). -->
            <ContentControl x:Name="LoadingDots"
                            HorizontalAlignment="Left"
                            Style="{StaticResource LoadingDotsStyle}"
                            Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
