<Window x:Class="OcSetup.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:OcSetup.ViewModels"
        Title="oc dependencies"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="3" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Background" Value="{StaticResource ControlAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- The default CheckBox template draws system-colored (black) text on the dark background. -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ControlAltBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource SmallCornerRadius}">
                                <Path x:Name="Mark"
                                      Data="M 3,8 L 6.5,11.5 L 13,4.5"
                                      Stroke="{StaticResource PrimaryTextBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ListPanel" Margin="{StaticResource PageMargin}" Style="{StaticResource ContentPanelStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- Tags line up after the widest label among tagged rows: each tagged row puts a
                     hidden copy of its checkbox in a shared-size column; untagged rows collapse it.
                     The shortcut column shares its width with the header above it. -->
                <StackPanel Grid.IsSharedSizeScope="True">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Margin="16,0,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Desktop shortcut" />
                </Grid>
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:DependencyRow}">
                            <StackPanel Margin="0,0,0,10" ToolTip="{Binding ToolTip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox HorizontalAlignment="Left"
                                              Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked}"
                                              IsEnabled="{Binding CanCheck}" />
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TaggedLabel" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="TagBadge" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Content="{Binding Label}" Focusable="False">
                                            <CheckBox.Style>
                                                <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTag}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <Border Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                BorderBrush="{StaticResource AccentBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource SmallCornerRadius}"
                                                ToolTip="{Binding TagToolTip}"
                                                Visibility="{Binding HasTag, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{StaticResource FocusBrush}"
                                                       Text="{Binding TagText}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding StatusText}" />
                                    <!-- Hidden (not collapsed) on rows without a shortcut keeps the column aligned. -->
                                    <CheckBox Grid.Column="2"
                                              Margin="16,0,0,0"
                                              HorizontalAlignment="Center"
                                              IsChecked="{Binding WantsShortcut}"
                                              IsEnabled="{Binding CanShortcut}"
                                              ToolTip="Create a desktop shortcut">
                                        <CheckBox.Style>
                                            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasShortcut}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </Grid>
                                <ProgressBar Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibility}}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                                             Maximum="100"
                                             Value="{Binding ProgressValue, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Shown after an install run; replaces the list and the bottom bar. -->
        <Border x:Name="DonePanel"
                Grid.RowSpan="2"
                Margin="{StaticResource PageMargin}"
                Style="{StaticResource ContentPanelStyle}"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="DoneHeading"
                           DockPanel.Dock="Top"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource NeutralButtonStyle}"
                            Content="Back to list"
                            Click="BackButton_Click" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource NeutralButtonStyle}"
                            Content="Close"
                            Click="CloseButton_Click" />
                    <Button x:Name="OpenOcButton"
                            DockPanel.Dock="Right"
                            Content="Open oc and close"
                            Click="OpenOcButton_Click" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,0,0,12"
                           FontSize="14"
                           Text="Open oc now?" />
                <TextBlock x:Name="DoneDetails"
                           Margin="0,16,0,16"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>

        <DockPanel x:Name="BottomBar" Grid.Row="1" Margin="{StaticResource PageMargin}" LastChildFill="True">
            <Button x:Name="InstallButton"
                    DockPanel.Dock="Right"
                    Content="Install selected"
                    IsEnabled="False"
                    Click="InstallButton_Click" />
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
